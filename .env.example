# Firecrawl (only used for search, map and HTML-report scrape)
FIRECRAWL_API_KEY=fc-your-key

# Microsoft Foundry, OpenAI-compatible endpoint (must end in /openai/v1/)
FOUNDRY_ENDPOINT=https://<your-resource>.services.ai.azure.com/openai/v1/
FOUNDRY_API_KEY=your-foundry-key
# The DEPLOYMENT name (not the model family name)
FOUNDRY_DEPLOYMENT=gpt-4.1

# Or Google Vertex AI (Gemini) instead of Foundry: set LLM_PROVIDER=vertex. No key:
# sign in once with `gcloud auth application-default login`.
LLM_PROVIDER=foundry
VERTEX_PROJECT=your-gcp-project-id
VERTEX_LOCATION=global
VERTEX_MODEL=google/gemini-2.5-flash

# Optional: contact (email or URL) sent in the User-Agent to Wikidata, as Wikimedia's
# API policy asks. Without it, Wikidata rate-limits harder during batch runs.
WIKIMEDIA_CONTACT=

# Required for the SEC EDGAR route (US companies): the SEC refuses requests without a
# contact in the User-Agent. Your email (or your team's).
SEC_CONTACT=

# Optional: UK company registry route. A free LIVE REST key from
# developer.company-information.service.gov.uk (test-environment keys are refused).
COMPANIES_HOUSE_API_KEY=

# Optional: OpenFIGI (tickers). Works without a key at 25 requests a minute; a free
# key from openfigi.com/api raises that to 250. Worth it for runs of thousands.
OPENFIGI_API_KEY=
